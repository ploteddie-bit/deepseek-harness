const testToolSignal = new AbortController().signal

/**
 * Behavior suite for the failure-loop guard: exact-failure, same-tool-failure,
 * and idempotent no-progress detection, per-agent window isolation, resets
 * (success, user prompt), transparency (`exclude` / `idempotentTools`),
 * advisory fold-onto-downstream semantics, and fail-loud config validation —
 * all driven through a real agent loop against a scripted mock adapter (no
 * network).
 */

/**
 * Boot the core spine + the guard; `readResults` scripts the idempotent `read`
 * tool's returned text so tests can stage unchanged-then-changed results.
 */
async function harness(config: Config = {}, readResults: string[] = []): Promise<Context> {
  const ctx = new Context()
  await mountAgentLoopTestDependencies(ctx)
  // AgentLoop declares the registry as a required injection.
  await ctx.plugin(SessionProjectionRegistry)
  await ctx.plugin(AgentLoop, { agents: [] })
  await ctx.plugin(FailureLoopGuard, config)
  ctx.tools.register(defineContentToolFixture({
    name: 'failing', description: 'f', parameters: {},
    async execute() { throw new Error('boom') },
  }))
  ctx.tools.register(defineContentToolFixture({
    name: 'ok', description: 'o', parameters: {},
    async execute() { return [{ type: 'text', text: 'ok' }] },
  }))
  ctx.tools.register(defineContentToolFixture({
    name: 'read', description: 'r', parameters: {},
    async execute() { return [{ type: 'text', text: readResults.shift() ?? 'data' }] },
  }))
  return ctx
}

function waitForIdle(ctx: Context, agent: Agent): Promise<void> {
  return new Promise((resolve) => { const d = ctx.on('agent/status', ({ agent: s, status: st }) => { if (s === agent && st === 'idle') { d(); resolve() } }) })
}

/** Every injected-context user message in the agent's log, flattened to joined text + source for terse assertions. */
function reminders(agent: Agent): { text: string; source: unknown }[] {
  return agent.session.snapshotEvents()
    .filter((e): e is SessionEvent<'user/message'> => e.type === 'user/message' && e.data.source.kind !== 'user')
    .map(e => ({
      text: e.data.content.map(block => block.type === 'text' ? block.text : '').join('|'),
      source: e.data.source,
    }))
}

/** The agent's tool-result events, for asserting block vs. pass outcomes. */
function toolResults(agent: Agent): SessionEvent<'tool/result'>[] {
  return agent.session.snapshotEvents()
    .filter((e): e is SessionEvent<'tool/result'> => e.type === 'tool/result')
}

/** The `notice`-form source the guard stamps, including the signal that fired. */
const guardSource = (signal: string, tool: string, count: number) => ({
  kind: 'plugin',
  plugin: 'failure-loop',
  form: 'notice',
  summary: `${signal}: ${tool} × ${count}`,
})

describe('exact failure', () => {
  it('stays silent below the exact-failure threshold', async () => {
    const ctx = await harness()
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'same' }),
      toolCallResponse('c2', 'failing', { q: 'same' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })

  it('reminds at the exact-failure threshold (three identical failing calls)', async () => {
    const ctx = await harness()
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'same' }),
      toolCallResponse('c2', 'failing', { q: 'same' }),
      toolCallResponse('c3', 'failing', { q: 'same' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const found = reminders(agent)
    expect(found).toHaveLength(1)
    expect(found[0]!.text).toContain('failed 3 times with identical arguments')
    expect(found[0]!.source).toEqual(guardSource('exact-failure', 'failing', 3))
  })
})

