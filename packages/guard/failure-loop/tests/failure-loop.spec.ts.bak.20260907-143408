describe('idempotent no-progress', () => {
  it('reminds when an idempotent tool returns the same result repeatedly', async () => {
    const ctx = await harness({}, ['X', 'X', 'X', 'X', 'X'])
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'read', { q: 'a' }),
      toolCallResponse('c2', 'read', { q: 'a' }),
      toolCallResponse('c3', 'read', { q: 'a' }),
      toolCallResponse('c4', 'read', { q: 'a' }),
      toolCallResponse('c5', 'read', { q: 'a' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const found = reminders(agent)
    expect(found).toHaveLength(1)
    expect(found[0]!.text).toContain('returned the same result 5 times')
    expect(found[0]!.source).toEqual(guardSource('idempotent-no-progress', 'read', 5))
  })

  it('rekeys no-progress when the result changes', async () => {
    const ctx = await harness({}, ['X', 'X', 'Y', 'X', 'X'])
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'read', { q: 'a' }),
      toolCallResponse('c2', 'read', { q: 'a' }),
      toolCallResponse('c3', 'read', { q: 'a' }), // 'Y' breaks the unchanged-result streak
      toolCallResponse('c4', 'read', { q: 'a' }),
      toolCallResponse('c5', 'read', { q: 'a' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })

  it('ignores tools outside idempotentTools', async () => {
    const ctx = await harness({ idempotentTools: ['glob'] }, ['X', 'X', 'X', 'X', 'X'])
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'read', { q: 'a' }),
      toolCallResponse('c2', 'read', { q: 'a' }),
      toolCallResponse('c3', 'read', { q: 'a' }),
      toolCallResponse('c4', 'read', { q: 'a' }),
      toolCallResponse('c5', 'read', { q: 'a' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })
})

describe('reset semantics', () => {
  it('a successful call resets the failure streak', async () => {
    const ctx = await harness()
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'a' }),
      toolCallResponse('c2', 'failing', { q: 'a' }), // exact streak 2
      toolCallResponse('c3', 'ok', {}),              // success breaks the streak
      toolCallResponse('c4', 'failing', { q: 'a' }), // streak 1
      toolCallResponse('c5', 'failing', { q: 'a' }), // streak 2 — still under 3
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })

  it('a new user prompt resets the window', async () => {
    const ctx = await harness()
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'a' }),
      toolCallResponse('c2', 'failing', { q: 'a' }),
      textResponse('turn one done'),
      toolCallResponse('c3', 'failing', { q: 'a' }), // without the reset this would be the 3rd
      textResponse('turn two done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'again' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })
})

describe('isolation and transparency', () => {
  it('keys state per agent: one agent failing never trips another', async () => {
    const ctx = await harness()
    ctx.llm.registerAdapter(['mock-a'], new MockAdapter([
      toolCallResponse('a1', 'failing', { q: 1 }),
      toolCallResponse('a2', 'failing', { q: 1 }),
      textResponse('done'),
    ]))
    ctx.llm.registerAdapter(['mock-b'], new MockAdapter([
      toolCallResponse('b1', 'failing', { q: 1 }),
      toolCallResponse('b2', 'failing', { q: 1 }),
      toolCallResponse('b3', 'failing', { q: 1 }),
      textResponse('done'),
    ]))
    const agentA = await ctx.agentLoop.create(SessionId('a'), { provider: 'mock-a', model: 'model-a' })
    const agentB = await ctx.agentLoop.create(SessionId('b'), { provider: 'mock-b', model: 'model-b' })
    agentA.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    agentB.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await Promise.all([waitForIdle(ctx, agentA), waitForIdle(ctx, agentB)])

    expect(reminders(agentA)).toHaveLength(0) // 2 failures < 3, despite B's 3 in the same registry
    expect(reminders(agentB)).toHaveLength(1)
  })

  it('excluded tools are transparent: their failures neither count nor reset', async () => {
    const ctx = await harness({ exclude: ['failing'] })
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'a' }),
      toolCallResponse('c2', 'failing', { q: 'a' }),
      toolCallResponse('c3', 'failing', { q: 'a' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })

  it('ignores direct executes with no agent (they neither crash nor advance any window)', async () => {
    const ctx = await harness({ exactFailureThreshold: 2 })
    const direct = await ctx.tools.execute({ signal: testToolSignal, callId: ToolCallId('d1'), name: 'failing', arguments: { q: 1 } })
    expect(direct.isError).toBe(true)

    ctx.llm.registerAdapter(['mock'], new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 1 }), // if the direct call had counted, this would be #2
      textResponse('done'),
    ]))
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(0)
  })
})

describe('advisory semantics', () => {
  it('never blocks on its own: a repeated successful read stays a success', async () => {
    const ctx = await harness({}, ['X', 'X', 'X', 'X', 'X'])
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'read', { q: 'a' }),
      toolCallResponse('c2', 'read', { q: 'a' }),
      toolCallResponse('c3', 'read', { q: 'a' }),
      toolCallResponse('c4', 'read', { q: 'a' }),
      toolCallResponse('c5', 'read', { q: 'a' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    expect(reminders(agent)).toHaveLength(1)
    const results = agent.session.snapshotEvents().filter((e): e is SessionEvent<'tool/result'> => e.type === 'tool/result')
    expect(results).toHaveLength(5)
    expect(results.every(r => r.data.message.content[0].isError !== true)).toBe(true)
  })

  it('folds the reminder onto a downstream block and keeps its feedback', async () => {
    const ctx = await harness({ exactFailureThreshold: 2 })
    ctx.on('tools/post-execute', async () => ({
      kind: 'block' as const,
      feedback: [{ type: 'text' as const, text: 'nope' }],
      additionalContexts: [createUserMessage({
        content: [{ type: 'text' as const, text: 'downstream-ctx' }], source: { kind: 'plugin' as const, plugin: 'test' },
      })],
    }))
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 1 }),
      toolCallResponse('c2', 'failing', { q: 1 }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const found = reminders(agent)
    expect(found).toHaveLength(3)
    // Only the repeated failing call adds guard context; downstream source fields survive.
    expect(found[0]!.text).toBe('downstream-ctx')
    expect(found[0]!.source).toEqual({ kind: 'plugin', plugin: 'test' })
    expect(found[1]!.text).toContain('failed 2 times with identical arguments')
    expect(found[1]!.source).toEqual(guardSource('exact-failure', 'failing', 2))
    expect(found[2]).toEqual({ text: 'downstream-ctx', source: { kind: 'plugin', plugin: 'test' } })
    // The block's feedback reached the tool result unchanged.
    const results = agent.session.snapshotEvents().filter((e): e is SessionEvent<'tool/result'> => e.type === 'tool/result')
    expect(results.every(r => r.data.message.content[0].isError)).toBe(true)
    expect(results[1]!.data.message.content[0].content).toEqual([{ type: 'text', text: 'nope' }])
  })
})

describe('hard stop', () => {
  it('blocks once a signal reaches hardStopThreshold', async () => {
    const ctx = await harness({ hardStop: true, hardStopThreshold: 2, exactFailureThreshold: 2 })
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'same' }),
      toolCallResponse('c2', 'failing', { q: 'same' }),
      toolCallResponse('c3', 'failing', { q: 'same' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const results = toolResults(agent)
    expect(results).toHaveLength(3)
    // The first failure is the tool's own error; the second and third are hard-stopped.
    expect(results[0]!.data.message.content[0].content[0].text).not.toContain('Hard stop')
    expect(results[1]!.data.message.content[0].content[0].text).toContain('Hard stop')
    expect(results[2]!.data.message.content[0].content[0].text).toContain('Hard stop')
  })

  it('stays advisory below hardStopThreshold', async () => {
    const ctx = await harness({ hardStop: true, hardStopThreshold: 4, exactFailureThreshold: 2 })
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'same' }),
      toolCallResponse('c2', 'failing', { q: 'same' }),
      toolCallResponse('c3', 'failing', { q: 'same' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const results = toolResults(agent)
    expect(results).toHaveLength(3)
    expect(results.every(r => !r.data.message.content[0].content[0].text.includes('Hard stop'))).toBe(true)
    // The advisory reminder still fires at counts 2 and 3.
    expect(reminders(agent)).toHaveLength(2)
  })

  it('is advisory by default: past the default threshold it still never blocks', async () => {
    const ctx = await harness() // hardStop: false by default
    const adapter = new MockAdapter([
      toolCallResponse('c1', 'failing', { q: 'same' }),
      toolCallResponse('c2', 'failing', { q: 'same' }),
      toolCallResponse('c3', 'failing', { q: 'same' }),
      toolCallResponse('c4', 'failing', { q: 'same' }),
      textResponse('done'),
    ])
    ctx.llm.registerAdapter(['mock'], adapter)
    const agent = await ctx.agentLoop.create(SessionId('a1'), { provider: 'mock', model: 'mock' })
    agent.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await waitForIdle(ctx, agent)

    const results = toolResults(agent)
    expect(results).toHaveLength(4)
    expect(results.every(r => !r.data.message.content[0].content[0].text.includes('Hard stop'))).toBe(true)
    // Advisory reminders fire at counts 3 and 4 (default exactFailureThreshold 3).
    expect(reminders(agent)).toHaveLength(2)
  })

  it('keys hard stop per agent: one agent blocked never blocks another', async () => {
    const ctx = await harness({ hardStop: true, hardStopThreshold: 3 })
    ctx.llm.registerAdapter(['mock-a'], new MockAdapter([
      toolCallResponse('a1', 'failing', { q: 1 }),
      toolCallResponse('a2', 'failing', { q: 1 }),
      toolCallResponse('a3', 'failing', { q: 1 }),
      textResponse('done'),
    ]))
    ctx.llm.registerAdapter(['mock-b'], new MockAdapter([
      toolCallResponse('b1', 'failing', { q: 1 }),
      toolCallResponse('b2', 'failing', { q: 1 }),
      textResponse('done'),
    ]))
    const agentA = await ctx.agentLoop.create(SessionId('a'), { provider: 'mock-a', model: 'model-a' })
    const agentB = await ctx.agentLoop.create(SessionId('b'), { provider: 'mock-b', model: 'model-b' })
    agentA.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    agentB.followup(createUserMessage({ content: [{ type: 'text', text: 'go' }], source: { kind: 'user' } }))
    await Promise.all([waitForIdle(ctx, agentA), waitForIdle(ctx, agentB)])

    const resultsA = toolResults(agentA)
    const resultsB = toolResults(agentB)
    expect(resultsA).toHaveLength(3)
    expect(resultsB).toHaveLength(2)
    expect(resultsA[2]!.data.message.content[0].content[0].text).toContain('Hard stop')
    expect(resultsB.every(r => !r.data.message.content[0].content[0].text.includes('Hard stop'))).toBe(true)
  })
})

describe('config validation fails loud', () => {
  async function spine(): Promise<Context> {
    const ctx = new Context()
    await mountAgentLoopTestDependencies(ctx)
    await ctx.plugin(SessionProjectionRegistry)
    await ctx.plugin(AgentLoop, { agents: [] })
    return ctx
  }

  it('rejects a threshold below 2', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { exactFailureThreshold: 1 })).rejects.toThrow(/integer >= 2/)
  })

  it('rejects a non-integer threshold', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { sameToolFailureThreshold: 2.5 })).rejects.toThrow(/integer >= 2/)
  })

  it('rejects a non-positive idempotent no-progress threshold', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { idempotentNoProgressThreshold: 0 })).rejects.toThrow(/integer >= 2/)
  })

  it('rejects an invalid window', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { window: 1 })).rejects.toThrow(/window/)
  })

  it('rejects a window smaller than a threshold', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { window: 4, sameToolFailureThreshold: 5 })).rejects.toThrow(/smaller than a threshold/)
  })

  it('rejects a hardStopThreshold below 2', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { hardStop: true, hardStopThreshold: 1 })).rejects.toThrow(/integer >= 2/)
  })

  it('rejects a non-integer hardStopThreshold', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { hardStop: true, hardStopThreshold: 2.5 })).rejects.toThrow(/integer >= 2/)
  })

  it('rejects a window smaller than hardStopThreshold when hard stop is armed', async () => {
    const ctx = await spine()
    await expect(ctx.plugin(FailureLoopGuard, { hardStop: true, hardStopThreshold: 10, window: 5 })).rejects.toThrow(/smaller than a threshold/)
  })
})
